#!/bin/sh
set -e

# ==============================================================================
# StoreSwitcher 2 Pro - Post-Installation Hook (iOS 15 Rootless)
# ==============================================================================

ROOTLESS_PREFIX=""
if [ -d "/var/jb" ]; then
    ROOTLESS_PREFIX="/var/jb"
fi

CONFIG_DIR="${ROOTLESS_PREFIX}/var/mobile/Library/StoreSwitcher"
mkdir -p "$CONFIG_DIR"
chown -R mobile:mobile "$CONFIG_DIR" 2>/dev/null || true
chmod 0755 "$CONFIG_DIR"

# Khóa quyền bảo mật chmod 0600 cho database & vault
if [ -f "$CONFIG_DIR/storeswitcher.db" ]; then
    chmod 0600 "$CONFIG_DIR/storeswitcher.db"
fi
if [ -f "$CONFIG_DIR/vault.json" ]; then
    chmod 0600 "$CONFIG_DIR/vault.json"
fi

# Khởi động lại các tiến trình App Store & StoreKit để nạp hook mới
killall -9 AppStore StoreKitUIService StoreKitViewService 2>/dev/null || true

echo "✓ [StoreSwitcher 2 Pro v2.2.1] Đã cài đặt thành công cho iOS 15 Rootless!"
exit 0
